# TriageGate Environment Configuration
# Copy this to .env and fill in your values

# --- Tier-2 LLM Configuration ---
# Leave blank to use the built-in Mock LLM (fully functional, no cost)
GEMINI_API_KEY=

# Optional: Use an OpenAI-compatible endpoint instead
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- App Configuration ---
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./triagegate.db

# --- Tier-1 Thresholds ---
ERROR_RATE_THRESHOLD=0.15
P95_LATENCY_THRESHOLD_MS=1200
WINDOW_SECONDS=5

# --- Tier-2 Deduplication ---
DEDUP_COOLDOWN_SECONDS=60

# --- Cost Model (USD per 1M tokens, for ROI calculation) ---
# Using Gemini 1.5 Flash pricing as baseline
LLM_INPUT_COST_PER_1M=0.075
LLM_OUTPUT_COST_PER_1M=0.30
AVG_INPUT_TOKENS_PER_CALL=800
AVG_OUTPUT_TOKENS_PER_CALL=200
